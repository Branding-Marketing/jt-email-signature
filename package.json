{
  "name": "jt-email-signature",
  "version": "1.0.0",
  "description": "J&T Express Australia email signature generator with Feishu auto-fill",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "webpack --mode development && concurrently -n webpack,worker \"webpack --mode development --watch\" \"wrangler dev --port 3000\"",
    "build": "webpack --mode production",
    "typecheck": "tsc -p worker/tsconfig.json",
    "deploy": "npm run build && wrangler deploy"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.6",
    "html-webpack-plugin": "^5.6.8",
    "ts-loader": "^9.6.2",
    "typescript": "5.9",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "wrangler": "^4.157.0"
  }
}
