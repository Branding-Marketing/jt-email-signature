{
  "name": "jt-email-signature",
  "version": "1.0.0",
  "description": "J&T Express Australia email signature generator with Feishu auto-fill",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "concurrently -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "PORT=3001 tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:client": "webpack serve --mode development",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "webpack --mode production",
    "typecheck": "tsc -p tsconfig.server.json --noEmit",
    "start": "node --env-file-if-exists=.env dist/server/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.3.0",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.6",
    "html-webpack-plugin": "^5.6.8",
    "ts-loader": "^9.6.2",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0"
  }
}
