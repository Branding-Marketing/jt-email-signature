{
  "name": "jt-email-signature",
  "version": "1.0.0",
  "description": "J&T Express Australia email signature generator with Feishu auto-fill",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "webpack --mode development && concurrently -n webpack,worker \"webpack --mode development --watch\" \"wrangler dev --port 3000\"",
    "build": "webpack --mode production",
    "typecheck": "tsc -p worker/tsconfig.json",
    "deploy": "npm run build && wrangler deploy"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.67.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.6",
    "css-loader": "^7.1.5",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.32",
    "postcss-loader": "^8.2.1",
    "tailwindcss": "^4.3.4",
    "ts-loader": "^9.6.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "wrangler": "^4.157.0"
  }
}
