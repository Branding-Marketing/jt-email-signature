# Copy to .env and fill in. Never commit .env.

# Feishu self-built app credentials (Developer Console > Credentials & Basic Info)
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=replace-me

# Must exactly match an entry in Developer Console > Security Settings > Redirect URLs
FEISHU_REDIRECT_URI=http://localhost:3000/api/auth/feishu/callback

# Random string used to sign session cookies, e.g. `openssl rand -hex 32`
SESSION_SECRET=replace-me

# Optional: extra user-identity scopes requested at login (space separated)
# FEISHU_OAUTH_SCOPE=

# Optional: Express port in production (dev uses 3001 behind the webpack dev server on 3000)
# PORT=3000
